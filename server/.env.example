# MongoDB Atlas connection string, with your database name after the host
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/task-tracker?retryWrites=true&w=majority
# Local port (ignored on Vercel)
PORT=5000
# Frontend origin(s), comma separated, no trailing slash. Also used for password-reset links.
CLIENT_URL=http://localhost:5173
